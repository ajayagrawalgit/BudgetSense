# Platform build artifacts
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
# Regenerated by `flutter pub get`. These bake in the absolute path of whoever
# built last, so they must stay out of the repo.
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
android/.gradle/
android/.kotlin/
android/build/
android/flutter-engine-repo/
android/local.properties
android/key.properties

# Build outputs / distributables (never commit binaries). Release binaries are
# published as GitHub Release assets, not stored in the tree.
dist/
release-artifacts/
*.apk
*.aab
*.ipa

# Coverage
coverage/

# Security scanner working output and local tooling
.security-tools/
security/artifacts/raw/
*.sarif
*.symbols
mapping.txt
*.dSYM/

# Docs site build output + docs virtualenv (MkDocs)
site/
.venv-docs/
.venv/

# Byte-code left behind by the helper scripts in tool/
__pycache__/
*.py[cod]

# Local signing config (never commit). See android/key.properties.example.
android/app/*.keystore
