<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/month_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/widget_this_month" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/app_name" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_ink_faint"
        android:textSize="11sp"
        android:text="@string/widget_balance" />

    <TextView
        android:id="@+id/balance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_ink"
        android:textSize="26sp"
        android:textStyle="bold"
        android:text="@string/widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink_faint"
                android:textSize="11sp"
                android:text="@string/widget_income" />
            <TextView
                android:id="@+id/income_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_positive"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/widget_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink_faint"
                android:textSize="11sp"
                android:text="@string/widget_spend" />
            <TextView
                android:id="@+id/spend_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/widget_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink_faint"
                android:textSize="11sp"
                android:text="@string/widget_invested" />
            <TextView
                android:id="@+id/invested_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/widget_placeholder" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/section_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_border"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/month_label_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/widget_where_it_went" />

        <LinearLayout
            android:id="@+id/cat_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cat_label1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_soft"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
            <TextView
                android:id="@+id/cat_value1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cat_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cat_label2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_soft"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
            <TextView
                android:id="@+id/cat_value2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cat_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cat_label3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_soft"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
            <TextView
                android:id="@+id/cat_value3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cat_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cat_label4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_soft"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
            <TextView
                android:id="@+id/cat_value4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:text="@string/widget_placeholder" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
