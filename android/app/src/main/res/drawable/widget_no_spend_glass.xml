<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted-glass panel for the spend-activity widget under the transparent (glass)
  theme. Android widgets cannot do a true backdrop blur, so we simulate frosted
  glass: a warm, semi-transparent paper frost with a soft bright edge. The
  wallpaper shows through, but the card shape stays intact (macOS-glass feel)
  rather than the widget disappearing entirely.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_glass_fill" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_glass_stroke" />
</shape>
