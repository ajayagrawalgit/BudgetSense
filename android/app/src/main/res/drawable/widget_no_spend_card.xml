<?xml version="1.0" encoding="utf-8"?>
<!--
  Opaque paper card for the spend-activity widget (default theme). A crisp,
  native rounded rectangle so the card edges never distort when the launcher
  resizes the widget (the content is a separate, uniformly-scaled bitmap).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
