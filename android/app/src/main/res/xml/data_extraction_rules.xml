<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer controls. Combined with android:allowBackup="false"
  (which covers Android 11 and below), this keeps all BudgetSense data - the
  SQLite database, shared preferences, and files - off Google cloud auto-backup
  and out of device-to-device transfers. Financial data stays on this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
